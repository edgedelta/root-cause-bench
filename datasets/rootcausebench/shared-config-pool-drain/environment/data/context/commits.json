 {
  "sha": "6fba9a51cc6d75fb18853c9c7e058555f6a61045",
  "author": "mei.chen",
  "timestamp": "2026-07-20T09:05:00Z",
  "message": "feat(checkout): bounded retry for charge rpc",
  "files_changed": [
   "services/checkout/charge.go"
  ],
  "diff": "--- a/services/checkout/charge.go\n+++ b/services/checkout/charge.go\n@@ -41,7 +41,18 @@ func (s *Server) charge(ctx context.Context, req *pb.ChargeRequest) (*pb.ChargeResponse, error) {\n-\treturn s.payments.Charge(ctx, req)\n+\tif !s.flags.Enabled(\"charge_retry_enabled\") {\n+\t\treturn s.payments.Charge(ctx, req)\n+\t}\n+\tvar lastErr error\n+\tfor attempt := 0; attempt < 2; attempt++ {\n+\t\tresp, err := s.payments.Charge(ctx, req)\n+\t\tif err == nil || !errors.Is(err, ErrTransient) {\n+\t\t\treturn resp, err\n+\t\t}\n+\t\tlastErr = err\n+\t\ttime.Sleep(time.Duration(attempt+1) * 50 * time.Millisecond)\n+\t}\n+\treturn nil, lastErr\n }\n"
 },
